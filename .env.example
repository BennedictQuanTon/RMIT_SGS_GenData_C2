# Copy to .env (gitignored) and fill in. Used by scripts/setup-local.sh.
# Read https://tide.org/legal first: only you can accept Tide's Terms and give the licence email.
TIDE_LICENSE_EMAIL=
TIDE_TERMS_ACCEPTED=
# Master admin password for your local TideCloak container (never commit it).
KC_BOOTSTRAP_ADMIN_PASSWORD=
# Optional: realm name (use a new name if a previous attempt failed half-way).
TIDE_REALM=unfound
